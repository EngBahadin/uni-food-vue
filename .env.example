# FIB Payment Gateway Configuration
# Copy this file to .env and fill in your actual credentials

# FIB Base URL (staging environment)
VITE_FIB_BASE_URL=https://fib.stage.fib.iq

# FIB Online Payment Credentials
# Get these from FIB payment gateway documentation
VITE_FIB_CLIENT_ID=your-fib-client-id-here
VITE_FIB_CLIENT_SECRET=your-fib-client-secret-here

# Backend API URL
VITE_BASE_URL=http://localhost:8000
